{
  "metadata": {
    "version": "1.7",
    "updated": "2026-09-14",
    "source": "polymarket",
    "target": "kuest",
    "purpose": "Machine-readable mapping for automated migrations and LLM-assisted refactors"
  },
  "rules": {
    "domain_suffix": {
      "polymarket.com": "kuest.com"
    },
    "env_prefix": {
      "POLYMARKET_": "KUEST_"
    }
  },
  "endpoints": {
    "clob_api": {
      "polymarket": "https://clob.polymarket.com",
      "kuest": "https://clob.kuest.com"
    },
    "clob_ws": {
      "polymarket": "wss://ws-subscriptions-clob.polymarket.com",
      "kuest": "wss://ws-subscriptions-clob.kuest.com"
    },
    "data_api": {
      "polymarket": "https://data-api.polymarket.com",
      "kuest": "https://data-api.kuest.com"
    },
    "bridge_api": {
      "polymarket": "https://bridge.polymarket.com",
      "kuest": "https://bridge.kuest.com"
    },
    "rtds_ws": {
      "polymarket": "wss://ws-live-data.polymarket.com",
      "kuest": "wss://ws-live-data.kuest.com"
    },
    "gamma_api": {
      "polymarket": "https://gamma-api.polymarket.com",
      "kuest": "https://gamma-api.kuest.com"
    },
    "geoblock_api": {
      "polymarket": "https://polymarket.com/api/geoblock",
      "kuest": "https://geoblock.kuest.com"
    },
    "relayer_api": {
      "polymarket": "https://relayer.polymarket.com",
      "kuest": "https://relayer.kuest.com"
    },
    "v2_required_paths": {
      "version": "GET /version",
      "clob_market": "GET /clob-markets/{conditionId}",
      "builder_fees": "GET /fees/builder-fees/{builderCode}",
      "builder_trades": "GET /builder/trades?builder_code={builderCode}"
    }
  },
  "headers": {
    "POLYMARKET_ADDRESS": "KUEST_ADDRESS",
    "POLYMARKET_NONCE": "KUEST_NONCE",
    "POLYMARKET_SIGNATURE": "KUEST_SIGNATURE",
    "POLYMARKET_TIMESTAMP": "KUEST_TIMESTAMP",
    "POLYMARKET_API_KEY": "KUEST_API_KEY",
    "POLYMARKET_PASSPHRASE": "KUEST_PASSPHRASE"
  },
  "eip712": {
    "order_domain_name": {
      "polymarket": "Polymarket CTF Exchange",
      "kuest": "CTF Exchange"
    },
    "exchange_domain_version": {
      "polymarket_v1": "1",
      "polymarket_v2": "2",
      "kuest": "2"
    },
    "auth_domain_version": {
      "kuest": "1"
    },
    "signed_order_v2": {
      "remove_fields": [
        "taker",
        "expiration",
        "nonce",
        "feeRateBps"
      ],
      "add_fields": {
        "timestamp": "uint256 milliseconds",
        "metadata": "bytes32",
        "builder": "bytes32"
      },
      "signature_type": {
        "name": "DEPOSIT_WALLET",
        "value": 3
      },
      "offchain_fields": [
        "expiration for GTD orders"
      ],
      "owner": "KUEST_API_KEY, not KUEST_ADDRESS",
      "builder_code": "builder wallet encoded as bytes32(uint256(uint160(wallet)))"
    }
  },
  "env_vars": {
    "POLYMARKET_PRIVATE_KEY": "KUEST_PRIVATE_KEY",
    "POLYMARKET_API_KEY": "KUEST_API_KEY",
    "POLYMARKET_API_SECRET": "KUEST_API_SECRET",
    "POLYMARKET_API_PASSPHRASE": "KUEST_API_PASSPHRASE",
    "POLYMARKET_ADDRESS": "KUEST_ADDRESS"
  },
  "network": {
    "polymarket": {
      "chain_id": 137,
      "collateral": "pUSD"
    },
    "kuest": {
      "chain_id": 137,
      "collateral": "USDC Circle",
      "usdc_mainnet": "0x3c499c542cef5e3811e1192ce70d8cc03d5c3359"
    }
  },
  "contracts": {
    "kuest": {
      "ctf_exchange": "0xaa1b8dE834E16eC69C044F5300041673C968c9eF",
      "neg_risk_ctf_exchange": "0xe7FA09cA716FDf498d74AFF618d32AFeacc310aB",
      "neg_risk_adapter": "0xd9416E904e1ab925ad72F03F6D6ce0Aa80fd2dC5",
      "neg_risk_operator": "0x368ed63Ab10F35f2BDD576bDbF6B1eDD151cB619",
      "neg_risk_uma_ctf_adapter": "0x70DC1B3761F2902DF8F9b1B0C27dcEA128b4a876",
      "deposit_wallet_factory": "0x2CcdC6C5dDcd895aFcCD259F291de9b618A5cA6c",
      "deposit_wallet_beacon": "0x74a618eBdd62Ff8579A8FE94f5B888d7623b9C35",
      "deposit_wallet_impl": "0x65507Fa36589B3b2ceD54E77999909e843691e44"
    }
  },
  "optional_env_vars": [
    "CLOB_API_URL",
    "WS_CLOB_URL",
    "DATA_API_URL",
    "BRIDGE_API_URL",
    "RTDS_WS_URL",
    "GAMMA_API_URL"
  ],
  "sdk": {
    "rust": {
      "cargo": {
        "polymarket-client-sdk": "kuest-client-sdk"
      },
      "imports": {
        "polymarket_client_sdk": "kuest_client_sdk"
      }
    },
    "python": {
      "packages": {
        "py-clob-client": "kuest-py-clob-client",
        "py-order-utils": "kuest-py-order-utils",
        "py-builder-signing-sdk": "kuest-py-builder-signing-sdk",
        "py-eip712-structs": "kuest-py-eip712-structs",
        "py-clob-client-v2": "kuest-py-clob-client",
        "py-builder-relayer-client": "kuest-py-builder-relayer-client"
      },
      "imports": {
        "poly_eip712_structs": "kuest_eip712_structs",
        "py_clob_client_v2": "py_clob_client",
        "py_builder_relayer_client": "py_builder_relayer_client"
      },
      "unchanged_imports": [
        "py_clob_client",
        "py_order_utils",
        "py_builder_signing_sdk",
        "py_builder_relayer_client"
      ]
    },
    "typescript": {
      "packages": {
        "@polymarket/clob-client": "@kuestcom/clob-client",
        "@polymarket/clob-client-v2": "@kuestcom/clob-client",
        "@polymarket/builder-relayer-client": "@kuestcom/builder-relayer-client",
        "@polymarket/builder-signing-sdk": "@kuestcom/builder-signing-sdk"
      }
    }
  },
  "slug_migrations": {
    "replace_gamma_ids_with_slugs": true,
    "kuest_slug_endpoints": [
      "GET /other",
      "RTDS activity/comment subscriptions"
    ]
  },
  "kuest_only_market_mirror_extensions": {
    "optional": true,
    "omitted_when_unavailable": true,
    "base_fields_remain_kuest_identifiers": true,
    "gamma": {
      "field_pairs": {
        "conditionId": "mirrorConditionId",
        "clobTokenIds": "mirrorClobTokenIds"
      },
      "clob_token_ids_format": "JSON-array string with positional pairing",
      "market_filter": "GET /markets?mirror=true|false"
    },
    "clob": {
      "field_pairs": {
        "condition_id": "mirror_condition_id",
        "tokens[].token_id": "tokens[].mirror_token_id",
        "primary_token_id": "mirror_primary_token_id",
        "secondary_token_id": "mirror_secondary_token_id"
      },
      "compact_clob_market_pairs": {
        "c": "mirror_condition_id",
        "t[].t": "t[].mirror_token_id"
      }
    },
    "usage": "Optional for order submission; useful for discovery, arbitrage, and Kuest-to-Polymarket market mapping"
  },
  "verification": {
    "grep_absent": [
      "polymarket.com",
      "POLYMARKET_",
      "Polymarket CTF Exchange"
    ],
    "required_replacements": [
      "KUEST_",
      "CTF Exchange"
    ]
  },
  "notes": {
    "bridge_host_disabled_by_default": "Some Kuest SDKs ship Bridge/Gamma hosts disabled by default. Pass the Kuest host explicitly if you need Bridge.",
    "kuest_clob_order_owner": "Kuest CLOB order responses use ULID/string in owner. Deserialize this field as ULID/string."
  },
  "support": {
    "discord": "https://discord.gg/kuest",
    "channel": "#builders"
  },
  "relayer_wallet_only": {
    "builder_credentials_required": true,
    "builder_credentials": [
      "KUEST_BUILDER_API_KEY",
      "KUEST_BUILDER_SECRET",
      "KUEST_BUILDER_PASSPHRASE"
    ],
    "deposit_wallet_address_derivation": {
      "factory_method": "predictWalletAddress(bytes32 walletId)",
      "wallet_id": "bytes32(uint256(uint160(owner)))",
      "do_not_pass_implementation": true
    },
    "required_paths": [
      "GET /nonce",
      "POST /submit",
      "GET /transaction",
      "GET /transactions",
      "GET /deployed"
    ],
    "not_required": [
      "GET /relay-payload"
    ],
    "transaction_types": [
      "WALLET",
      "WALLET-CREATE"
    ],
    "replace_transaction_types": {
      "from": [
        "SAFE",
        "PROXY"
      ],
      "to": [
        "WALLET",
        "WALLET-CREATE"
      ]
    }
  }
}
